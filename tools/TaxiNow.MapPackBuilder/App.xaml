<Application x:Class="TaxiNow.MapPackBuilder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBackground" Color="#071726" />
    <SolidColorBrush x:Key="PanelBackground" Color="#0D2333" />
    <SolidColorBrush x:Key="PanelBorder" Color="#24445A" />
    <SolidColorBrush x:Key="PrimaryText" Color="#E8F1F7" />
    <SolidColorBrush x:Key="SecondaryText" Color="#9DB3C2" />
    <SolidColorBrush x:Key="Accent" Color="#48E0CD" />
    <SolidColorBrush x:Key="AccentDark" Color="#163B43" />
    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource WindowBackground}" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
      <Setter Property="Padding" Value="0,0,0,5" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#06131F" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#193247" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
      <Setter Property="BorderBrush" Value="#365970" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="#041410" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
      <Setter Property="Margin" Value="0,0,22,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Application.Resources>
</Application>
