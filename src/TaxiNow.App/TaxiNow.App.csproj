<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TaxiNow.Server\TaxiNow.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\tests\fixtures\airport-maps\CYYZ.v2.json"
             Link="fixtures\airport-maps\CYYZ.v2.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tests\fixtures\telemetry\cyyz-taxi.jsonl"
             Link="fixtures\telemetry\cyyz-taxi.jsonl"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\map_pipeline\taxinow_map_pipeline.py"
             Link="pipeline\taxinow_map_pipeline.py"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\TaxiNow.Web\dist\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('..\TaxiNow.Web\dist')" />
  </ItemGroup>
</Project>
