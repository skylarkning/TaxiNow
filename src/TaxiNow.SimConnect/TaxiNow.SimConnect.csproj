<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);TAXINOW_MANAGED_SIMCONNECT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TaxiNow.Core\TaxiNow.Core.csproj" />
    <PackageReference Include="CTrue.FsConnect"
                      Version="1.4.0"
                      GeneratePathProperty="true" />
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(PkgCTrue_FsConnect)\lib\net461\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="$(PkgCTrue_FsConnect)\build\simconnect.dll"
             Link="SimConnect.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
